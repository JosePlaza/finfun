# Copia este archivo a .env (o .env.local) y rellena los valores de tu proyecto Supabase
# (Project Settings → API). Sin ellos, Finfun funciona en modo local: guarda en el navegador,
# usa la hora del dispositivo y no pide cuenta.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Barra de desarrollo (?dev en la URL) también en producción. Déjalo vacío en Vercel.
VITE_ALLOW_DEV=
